// ============ НАВИГАЦИЯ ============
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('screen-' + id).classList.add('active');
  if (id === 'map') renderMap();
  if (id === 'inventory') renderInventory();
  if (id === 'task') renderTask();
  updateHUD();
}

function updateHUD() {
  const g = document.getElementById('hud-goals');
  const p = document.getElementById('hud-points');
  const l = document.getElementById('hud-level');
  if (g) g.textContent = state.goals;
  if (p) p.textContent = state.points;
  if (l) l.textContent = state.currentLevel + 1;
}

// ============ КАРТА ============
function renderMap() {
  const grid = document.getElementById('map-grid');
  grid.innerHTML = '';
  tasks.forEach((t, i) => {
    const node = document.createElement('div');
    node.className = 'map-node';
    const isCompleted = state.completed.includes(i);
    const isCurrent = i === state.currentLevel;
    const isLocked = i > state.currentLevel && !isCompleted;
    if (isCompleted) node.classList.add('completed');
    else if (isCurrent) node.classList.add('current');
    else if (isLocked) node.classList.add('locked');
    node.innerHTML = `
      <div class="emoji">${t.emoji}</div>
      <div class="num">#${i+1}</div>
      <div style="font-size:8px; margin-top:4px;">${t.stadium.replace('Стадион ','').replace('«','').replace('»','')}</div>
    `;
    if (!isLocked) {
      node.onclick = () => {
        state.currentLevel = i;
        state.attempts = 0;
        showScreen('task');
      };
    }
    grid.appendChild(node);
  });
}

// ============ ЗАДАНИЯ ============
function renderTask() {
  const task = tasks[state.currentLevel];
  document.getElementById('task-level').textContent = state.currentLevel + 1;
  document.getElementById('task-goals').textContent = state.goals;
  document.getElementById('task-points').textContent = state.points;
  document.getElementById('task-title').textContent = task.title;
  const progress = (state.currentLevel / tasks.length) * 100;
  const pf = document.getElementById('task-progress');
  pf.style.width = progress + '%';
  pf.textContent = Math.round(progress) + '%';

  const content = document.getElementById('task-content');
  const actions = document.getElementById('task-actions');
  content.innerHTML = '';
  actions.innerHTML = '';
  hideFeedback();

  const q = document.createElement('div');
  q.className = 'task-question';
  q.textContent = task.question;
  content.appendChild(q);

  if (task.sentence) {
    const s = document.createElement('div');
    s.className = 'task-sentence';
    s.innerHTML = task.sentence.replace('___', '<span style="color:#4a90c2; font-weight:bold;">[???]</span>');
    content.appendChild(s);
  }

  if (task.type === 'truefalse' || task.type === 'choice') renderOptions(task, content, actions);
  else if (task.type === 'open') renderOpen(task, content, actions);
  else if (task.type === 'letters') renderLetters(task, content, actions);
  else if (task.type === 'dnd') renderDnD(task, content, actions);
}

function renderOptions(task, content, actions) {
  const opts = document.createElement('div');
  opts.className = 'options';
  task.options.forEach((opt, i) => {
    const o = document.createElement('div');
    o.className = 'option';
    o.textContent = opt;
    o.onclick = () => {
      if (i === task.correct) {
        o.classList.add('correct');
        setTimeout(() => handleSuccess(task), 700);
      } else {
        o.classList.add('wrong');
        showFeedback(false, 'Промах! Попробуй ещё раз.');
        state.attempts++;
      }
    };
    opts.appendChild(o);
  });
  content.appendChild(opts);
}

function renderOpen(task, content, actions) {
  if (task.hint) {
    const h = document.createElement('p');
    h.style.fontSize = '12px';
    h.style.color = '#4a90c2';
    h.textContent = task.hint;
    content.appendChild(h);
  }
  const inp = document.createElement('input');
  inp.type = 'text';
  inp.className = 'task-input';
  inp.placeholder = 'Введи ответ...';
  inp.id = 'open-answer';
  content.appendChild(inp);
  const btn = document.createElement('button');
  btn.className = 'btn primary';
  btn.textContent = '⚽ УДАР!';
  btn.onclick = () => {
    const val = inp.value.trim().toLowerCase().replace('ё','е');
    const correct = task.answer.toLowerCase().replace('ё','е');
    if (val === correct) {
      handleSuccess(task);
    } else {
      showFeedback(false, 'Мимо ворот! Правильный ответ: ' + task.answer);
      state.attempts++;
    }
  };
  actions.appendChild(btn);
}

function renderLetters(task, content, actions) {
  const word = task.word.toUpperCase().replace('Ё','Е');
  const letters = word.split('');
  const shuffled = [...letters].sort(() => Math.random() - 0.5);
  const slots = document.createElement('div');
  slots.className = 'answer-slots';
  slots.id = 'letter-slots';
  for (let i = 0; i < word.length; i++) {
    const s = document.createElement('div');
    s.className = 'slot';
    s.dataset.index = i;
    s.onclick = () => {
      if (s.classList.contains('filled')) {
        const letter = s.textContent;
        s.textContent = '';
        s.classList.remove('filled');
        // вернуть букву
        const allLetters = document.querySelectorAll('#letter-pool .letter');
        for (const l of allLetters) {
          if (l.classList.contains('used') && l.dataset.letter === letter && l.dataset.slot === s.dataset.index) {
            l.classList.remove('used');
            delete l.dataset.slot;
            break;
          }
        }
      }
    };
    slots.appendChild(s);
  }
  content.appendChild(slots);

  const pool = document.createElement('div');
  pool.className = 'letters';
  pool.id = 'letter-pool';
  shuffled.forEach((l, i) => {
    const el = document.createElement('div');
    el.className = 'letter';
    el.textContent = l;
    el.dataset.letter = l;
    el.dataset.id = i;
    el.onclick = () => {
      if (el.classList.contains('used')) return;
      // найти первую пустую слот
      const emptySlot = document.querySelector('#letter-slots .slot:not(.filled)');
      if (!emptySlot) return;
      emptySlot.textContent = l;
      emptySlot.classList.add('filled');
      el.classList.add('used');
      el.dataset.slot = emptySlot.dataset.index;
      // проверка завершения
      const filled = document.querySelectorAll('#letter-slots .slot.filled');
      if (filled.length === word.length) {
        const assembled = Array.from(document.querySelectorAll('#letter-slots .slot')).map(s => s.textContent).join('');
        if (assembled === word) {
          setTimeout(() => handleSuccess(task), 400);
        } else {
          showFeedback(false, 'Не то слово! Попробуй ещё.');
          state.attempts++;
        }
      }
    };
    pool.appendChild(el);
  });
  content.appendChild(pool);
}

function renderDnD(task, content, actions) {
  if (task.targets) {
    // Соответствие
    const targetsBox = document.createElement('div');
    task.targets.forEach((t, i) => {
      const row = document.createElement('div');
      row.style.display = 'flex';
      row.style.gap = '10px';
      row.style.margin = '8px 0';
      row.style.alignItems = 'center';
      row.style.flexWrap = 'wrap';
      const label = document.createElement('div');
      label.style.flex = '1';
      label.style.minWidth = '150px';
      label.style.fontWeight = 'bold';
      label.textContent = t.label + ':';
      const drop = document.createElement('div');
      drop.className = 'drop-target';
      drop.dataset.accept = t.accept;
      drop.dataset.idx = i;
      drop.textContent = 'перетащи сюда';
      drop.style.flex = '1';
      drop.style.minWidth = '150px';
      setupDropTarget(drop, task);
      row.appendChild(label);
      row.appendChild(drop);
      targetsBox.appendChild(row);
    });
    content.appendChild(targetsBox);
  } else {
    // Одно предложение
    const drop = document.createElement('div');
    drop.className = 'drop-target';
    drop.dataset.accept = task.correct;
    drop.textContent = 'перетащи причастный оборот сюда';
    setupDropTarget(drop, task);
    content.appendChild(drop);
  }

  const pool = document.createElement('div');
  pool.className = 'dnd-zone';
  pool.id = 'dnd-pool';
  const shuffled = [...task.items].sort(() => Math.random() - 0.5);
  shuffled.forEach(item => {
    const el = document.createElement('div');
    el.className = 'dnd-item';
    el.textContent = item;
    el.draggable = true;
    el.dataset.value = item;
    el.ondragstart = (e) => {
      e.dataTransfer.setData('text/plain', item);
      e.dataTransfer.setData('element-id', el.dataset.uid || (el.dataset.uid = 'u' + Math.random()));
    };
    // Touch support
    el.onclick = () => {
      if (el.classList.contains('placed')) return;
      const drops = document.querySelectorAll('.drop-target');
      for (const d of drops) {
        if (!d.dataset.filled) {
          placeItem(el, d, task);
          return;
        }
      }
    };
    pool.appendChild(el);
  });
  content.appendChild(pool);
}

function setupDropTarget(drop, task) {
  drop.ondragover = (e) => { e.preventDefault(); drop.classList.add('over'); };
  drop.ondragleave = () => drop.classList.remove('over');
  drop.ondrop = (e) => {
    e.preventDefault();
    drop.classList.remove('over');
    const value = e.dataTransfer.getData('text/plain');
    const elId = e.dataTransfer.getData('element-id');
    const el = document.querySelector(`[data-uid="${elId}"]`);
    if (el) placeItem(el, drop, task);
  };
}

function placeItem(el, drop, task) {
  const value = el.dataset.value;
  const expected = drop.dataset.accept;
  if (value === expected) {
    drop.textContent = value;
    drop.dataset.filled = '1';
    drop.style.background = '#a8e6a8';
    drop.style.borderStyle = 'solid';
    el.classList.add('placed');
    el.draggable = false;
    // Проверить все ли заполнены
    const allDrops = document.querySelectorAll('.drop-target');
    const allFilled = Array.from(allDrops).every(d => d.dataset.filled);
    if (allFilled) {
      setTimeout(() => handleSuccess(task), 500);
    }
  } else {
    drop.style.background = '#ffb3b3';
    showFeedback(false, 'Неверная позиция!');
    state.attempts++;
    setTimeout(() => { drop.style.background = ''; }, 500);
  }
}

// ============ УСПЕХ / НАГРАДА ============
function handleSuccess(task) {
  showFeedback(true, '⚽ ГОЛ! ' + (task.explanation || ''));
  state.goals++;
  const points = Math.max(10, 30 - state.attempts * 5);
  state.points += points;
  state.completed.push(state.currentLevel);
  // Награда в инвентарь
  const rewards = ['🥇','🥈','🥉','🏅','🎖️','🏆','⚽','👟','🧤','🎽'];
  state.inventory.push({
    icon: rewards[state.currentLevel] || '🏅',
    name: task.stadium,
    points: points
  });
  setTimeout(() => {
    if (state.currentLevel === tasks.length - 1) {
      showFinal();
    } else {
      showReward(points);
      state.currentLevel++;
    }
  }, 1500);
}

function showReward(points) {
  document.getElementById('reward-icon').textContent = state.inventory[state.inventory.length-1].icon;
  document.getElementById('reward-title').textContent = 'ГОЛ ЗАБИТ!';
  document.getElementById('reward-text').textContent = 'Ты прошёл стадион: ' + tasks[state.currentLevel-1].stadium;
  document.getElementById('reward-points').textContent = points;
  showScreen('reward');
  launchConfetti();
}

function showFinal() {
  document.getElementById('final-points').textContent = state.points;
  document.getElementById('final-goals').textContent = state.goals;
  showScreen('final');
  launchConfetti();
  launchConfetti();
}

function restartGame() {
  state.currentLevel = 0;
  state.goals = 0;
  state.points = 0;
  state.completed = [];
  state.inventory = [];
  state.attempts = 0;
  showScreen('title');
}

// ============ ИНВЕНТАРЬ ============
function renderInventory() {
  const grid = document.getElementById('inventory-grid');
  grid.innerHTML = '';
  if (state.inventory.length === 0) {
    grid.innerHTML = '<p style="grid-column:1/-1; text-align:center; color:#4a90c2;">Пока пусто. Забей первый гол!</p>';
    return;
  }
  state.inventory.forEach(item => {
    const el = document.createElement('div');
    el.className = 'inv-item';
    el.innerHTML = `<div class="icon">${item.icon}</div><div><b>${item.name}</b></div><div>+${item.points} ⭐</div>`;
    grid.appendChild(el);
  });
}

// ============ FEEDBACK ============
function showFeedback(success, text) {
  const f = document.getElementById('feedback');
  f.className = 'feedback show ' + (success ? 'success' : 'error');
  f.textContent = text;
}
function hideFeedback() {
  const f = document.getElementById('feedback');
  f.className = 'feedback';
  f.textContent = '';
}

// ============ КОНФЕТТИ ============
function launchConfetti() {
  const colors = ['#7ec8e3','#c0c0c0','#ffffff','#4a90c2','#a8e6a8'];
  for (let i = 0; i < 40; i++) {
    const c = document.createElement('div');
    c.className = 'confetti';
    c.style.left = Math.random() * 100 + 'vw';
    c.style.top = '-20px';
    c.style.background = colors[Math.floor(Math.random() * colors.length)];
    c.style.animationDelay = Math.random() * 0.5 + 's';
    c.style.animationDuration = (2 + Math.random() * 2) + 's';
    if (Math.random() > 0.5) c.style.borderRadius = '50%';
    document.body.appendChild(c);
    setTimeout(() => c.remove(), 4000);
  }
}

// Старт
updateHUD();
